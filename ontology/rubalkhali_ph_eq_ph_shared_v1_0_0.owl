  <rdf:Description rdf:about="https://rubalkhali.science/kb/RAK_PH_PROTOCOL_21b33e6a049affde216901505fa96e34b2d6f5e350226d4d4d66bccc99877876">
    <dcterms:description>Dry soil sieved below 2 mm and mixed without fine grinding; one independent 1 g scoop suspended in 2.5 mL 0.01 M CaCl2; two-point pH 7/10 calibration; pH 10 check accepted within 0.1 of nominal; slope target 95-102%; ATC enabled.</dcterms:description>
    <dcterms:identifier>EQ-PH-CACL2-1G-v1.0.0</dcterms:identifier>
    <dcterms:source rdf:resource="https://rubalkhali.science/kb/RAK_PH_SOURCE_bd6c096d8ea7c604edbd371d2ef748b407d736e360217a3a5050a1cbd9f42bc8" />
    <rdf:type rdf:resource="http://semanticscience.org/resource/SIO_001043" />
    <rdfs:label>1:2.5 CaCl2 soil-pH protocol</rdfs:label>
  </rdf:Description>

manifest {
    name = "empty-quarter-reproducibility"
    author = "Empty Quarter consortium"
    homePage = "https://github.com/bio-ontology-research-group/empty-quarter"
    description = "Evidence, ecological analysis, KG validation, and paper build workflow"
    version = "0.6.0"
    nextflowVersion = ">=25.10.4"
}

params {
    project_root = "${projectDir}/.."
    ecology_paper = "${projectDir}/../empty-quarter-amplicon"
    outdir = "${projectDir}/../results/reproducibility"
    stage = "evidence"
    run_advanced = false
    run_kg = false
    build_papers = false
    coverm_dir = null
    eggnog_annotations = null
    measured_function_inputs = null
    pma_asv_table = "${projectDir}/../data-paper/zenodo/metadata/relic-dna/PMA_ASV_table.tsv"
    functional_permutations = 999
    functional_max_kos = 2000
    execution_mode = "host-default"
    taxonomy_source_taxonomy = "${projectDir}/../data/processed/taxonomy/taxon-tables/taxonomy-trips1-5.tsv"
    taxonomy_feature_table = "${projectDir}/../data/processed/taxonomy/taxon-tables/feature-table-trips1-5.tsv"
    taxonomy_canonical_mapping = "${projectDir}/../data/processed/ontology/mapped_taxonomy.tsv"
    taxonomy_ncbi_owl = "${projectDir}/../data/ontologies/ncbitaxon.owl"
    taxonomy_sra_sheet = "${projectDir}/../data/metadata/sra-submissions/submission-sheet.tsv"
    taxonomy_java_opts = "-Xms2g -Xmx32g"
    analysis_container = null
    tex_container = null
}

process {
    errorStrategy = "terminate"
    maxRetries = 1
    shell = ["/bin/bash", "-euo", "pipefail"]

    withName:CAPTURE_PROVENANCE {
        cpus = 1
        memory = "1 GB"
        time = "30m"
    }
    withName:ENVIRONMENTAL_METADATA {
        cpus = 1
        memory = "4 GB"
        time = "1h"
    }
    withName:DATA_PAPER_FIGURES {
        cpus = 1
        memory = "2 GB"
        time = "30m"
    }
    withName:RELEASE_EVIDENCE {
        cpus = 2
        memory = "8 GB"
        time = "2h"
    }
    withName:GENERATE_CORE_KG_MODULES {
        cpus = 4
        memory = "24 GB"
        time = "6h"
    }
    withName:XRF_AUDIT {
        cpus = 4
        memory = "16 GB"
        time = "4h"
    }
    withName:COMPETENCY_QUERY_VALIDATION {
        cpus = 1
        memory = "4 GB"
        time = "1h"
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}
report {
    enabled = true
    file = "${params.outdir}/pipeline_info/report.html"
    overwrite = true
}
trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
    fields = "task_id,hash,native_id,name,status,exit,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,container,env"
}
dag.enabled = true
dag.file = "${params.outdir}/pipeline_info/dag.html"
dag.overwrite = true

profiles {
    bare {
        params.execution_mode = "bare-host"
        process {
            executor = "local"
        }
    }

    local {
        params.execution_mode = "docker-profile"
        process {
            executor = "local"
            container = params.analysis_container
            withName:CAPTURE_PROVENANCE {
                container = null
            }
            withName:BUILD_PAPERS {
                container = params.tex_container
            }
        }
        docker.enabled = true
        docker.runOptions = "-v ${params.project_root}:${params.project_root}:ro -v ${params.ecology_paper}:${params.ecology_paper}:ro"
    }

    ws {
        params.execution_mode = "singularity-ws-profile"
        process {
            executor = "local"
            maxForks = 4
            container = params.analysis_container
            withName:CAPTURE_PROVENANCE {
                container = null
            }
            withName:BUILD_PAPERS {
                container = params.tex_container
            }
        }
        singularity.enabled = true
        singularity.autoMounts = true
    }

    ws_host {
        params.execution_mode = "host-analysis-docker-tex-profile"
        process {
            executor = "local"
            maxForks = 4
            withName:CAPTURE_PROVENANCE {
                container = null
            }
            withName:CAPTURE_EXECUTION_ENVIRONMENT {
                container = null
            }
            withName:BUILD_PAPERS {
                container = params.tex_container
            }
        }
        docker.enabled = true
        docker.runOptions = "-v ${params.project_root}:${params.project_root}:ro -v ${params.ecology_paper}:${params.ecology_paper}:ro"
    }

    ibex {
        params.execution_mode = "singularity-ibex-profile"
        process {
            executor = "slurm"
            queue = "batch"
            clusterOptions = "--account=c2014"
            maxForks = 32
            container = params.analysis_container
            withName:GENERATE_TAXONOMY_ABOX {
                queue = "largemem"
            }
            withName:CAPTURE_PROVENANCE {
                container = null
            }
            withName:BUILD_PAPERS {
                container = params.tex_container
            }
        }
        workDir = System.getenv("EQ_NXF_WORK") ?: "${projectDir}/../work"
        singularity.enabled = true
        singularity.autoMounts = true
        singularity.cacheDir = System.getenv("NXF_SINGULARITY_CACHEDIR") ?: "${projectDir}/../.singularity"
        executor.queueSize = 100
    }

    debug {
        params.execution_mode = "singularity-ibex-debug-profile"
        process {
            executor = "slurm"
            queue = "debug"
            clusterOptions = "--account=c2014"
            time = "2h"
            maxForks = 4
            container = params.analysis_container
            withName:CAPTURE_PROVENANCE {
                container = null
            }
            withName:BUILD_PAPERS {
                container = params.tex_container
            }
        }
        workDir = System.getenv("EQ_NXF_DEBUG_WORK") ?: "${projectDir}/../debug-work"
        singularity.enabled = true
        singularity.autoMounts = true
    }

    test {
        params.stage = "evidence"
        params.outdir = "${projectDir}/../results/reproducibility-test"
        process {
            executor = "local"
            cpus = 1
            memory = "1 GB"
            time = "30m"
            withName:ECOLOGY_CORE {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:GENERATE_CORE_KG_MODULES {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:ECOLOGY_ADVANCED {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:KG_VALIDATE {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:BUILD_TAXONOMY_MAPPING {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:GENERATE_TAXONOMY_ABOX {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:FUNCTIONAL_REDUNDANCY_NULL {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
            withName:NETWORK_RESCUE {
                cpus = 1
                memory = "1 GB"
                time = "30m"
            }
        }
    }
}

<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Rub' al Khali with Heritage Sites</name>
    <Style id="desertStyle">
      <LineStyle>
        <color>ff0055ff</color> <width>2.5</width>
      </LineStyle>
      <PolyStyle>
        <color>8871b3f4</color> <outline>1</outline>
      </PolyStyle>
    </Style>
    <Placemark>
      <name>Rub' al Khali (The Empty Quarter)</name>
      <description>
        An approximate boundary of the Rub' al Khali desert. This boundary has been specifically drawn to include:
        1. The 'Uruq Bani Ma'arid UNESCO World Heritage Reserve.
        2. The ancient city of Qaryat al-Faw at the northwestern edge of the sand sea.
      </description>
      <styleUrl>#desertStyle</styleUrl>
      <Polygon>
        <tessellate>1</tessellate>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              46.50,17.45,0
              50.70,17.15,0
              53.25,17.00,0
              55.65,19.45,0
              55.80,22.50,0
              53.50,23.80,0
              51.00,24.10,0
              48.50,23.25,0
              46.00,21.50,0
              45.00,19.80,0
              44.80,19.00,0
              45.50,18.00,0
              46.50,17.45,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>
  </Document>
</kml>

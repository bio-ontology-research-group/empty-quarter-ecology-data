@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rak:  <https://rubalkhali.science/kb/> .

# Negative: a sampling site with no geo:asWKT geometry. Every released site
# individual carries one, so SamplingSiteShape requires it and this graph must
# be rejected.
rak:RAK_1099902 a rak:RAK_0000002 , owl:NamedIndividual ;
    rdfs:label "Fixture Site 2 without coordinates" .

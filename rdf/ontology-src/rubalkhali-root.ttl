@prefix : <http://rubalkhali.science/kb#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<http://rubalkhali.science/kb> rdf:type owl:Ontology ;
    owl:versionIRI <http://rubalkhali.science/kb/1.0.0> ;
    
    # --- Metadata ---
    dcterms:title "Rub al Khali Knowledge Base" ;
    dcterms:description "Integrated ontology for the Empty Quarter expedition, linking field data to genomic analysis." ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
    
    # --- Upper Ontologies ---
    owl:imports <http://semanticscience.org/ontology/sio.owl> , # SIO
                <http://purl.obolibrary.org/obo/envo.owl> ,    # Environment
                <http://purl.obolibrary.org/obo/pato.owl> ,    # Phenotype/Quality
                <http://purl.obolibrary.org/obo/uo.owl> ;      # Units of Measurement

    # --- Domain Modules (TBox) ---
    # These files define the specific classes and properties for the project
    owl:imports <modules/sites.ttl> ,
                <modules/samples.ttl> ,
                <modules/analysis.ttl> ;

    # --- Data Imports (ABox) ---
    # These point to the generated RDF data in the data directory.
    # Adjust paths as the pipeline generates them.
    rdfs:comment "Importing generated data files." .
    
    # Example of how data will be imported:
    # owl:imports <../../data/rdf/sites.ttl> .
    # owl:imports <../../data/rdf/samples.ttl> .

@prefix : <http://rubalkhali.science/kb#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sio: <http://semanticscience.org/resource/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://rubalkhali.science/kb/modules/analysis> rdf:type owl:Ontology .

#################################################################
#    Classes
#################################################################

###  http://rubalkhali.science/kb#AmpliconLibrary
:AmpliconLibrary rdf:type owl:Class ;
                 rdfs:subClassOf sio:SIO_001050 ;  # library
                 rdfs:label "16S Amplicon Library" .

###  http://rubalkhali.science/kb#AmpliconRegion
:AmpliconRegion rdf:type owl:Class ;
                rdfs:subClassOf sio:SIO_000030 ;  # object
                rdfs:label "PCR Amplicon Region" .

###  http://rubalkhali.science/kb#FASTQFile
:FASTQFile rdf:type owl:Class ;
           rdfs:subClassOf sio:SIO_000396 ;  # file
           rdfs:label "FASTQ File" .

###  http://rubalkhali.science/kb#SRARunAccession
:SRARunAccession rdf:type owl:Class ;
                 rdfs:subClassOf sio:SIO_000115 ;  # identifier
                 rdfs:label "SRA Run Accession" .

###  http://rubalkhali.science/kb#SequencingExperiment
:SequencingExperiment rdf:type owl:Class ;
                      rdfs:subClassOf sio:SIO_000006 ;  # process
                      rdfs:label "Sequencing Experiment" .

###  http://rubalkhali.science/kb#SequencingInstrument
:SequencingInstrument rdf:type owl:Class ;
                      rdfs:subClassOf sio:SIO_001236 ;  # device
                      rdfs:label "Sequencing Instrument" .

###  http://rubalkhali.science/kb#WorkflowExecution
:WorkflowExecution rdf:type owl:Class ;
                   rdfs:subClassOf sio:SIO_000006 ;  # process
                   rdfs:label "Workflow Execution" .

###  http://rubalkhali.science/kb#TaxonomicProfilingWorkflow
:TaxonomicProfilingWorkflow rdf:type owl:Class ;
                            rdfs:subClassOf sio:SIO_000127 ;  # collection
                            rdfs:label "Taxonomic Profiling Workflow" .

###  http://rubalkhali.science/kb#TaxonAbundanceTable
:TaxonAbundanceTable rdf:type owl:Class ;
                     rdfs:subClassOf sio:SIO_000089 ;  # dataset
                     rdfs:label "Taxon Abundance Table" .

###  http://rubalkhali.science/kb#RelativeAbundance
:RelativeAbundance rdf:type owl:Class ;
                   rdfs:subClassOf obo:PATO_0001470 ;  # proportion
                   rdfs:label "Relative Abundance" .

#################################################################
#    Properties
#################################################################

###  http://rubalkhali.science/kb#hasAmpliconRegion
:hasAmpliconRegion rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf sio:SIO_000061 ;  # has location
                   rdfs:domain :AmpliconLibrary ;
                   rdfs:range :AmpliconRegion ;
                   rdfs:label "has amplicon region" .

###  http://rubalkhali.science/kb#hasTaxonAbundance
:hasTaxonAbundance rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf sio:SIO_000217 ;  # has quality
                   rdfs:domain :TaxonAbundanceTable ;
                   rdfs:range :TaxonAbundance ;
                   rdfs:label "has taxon abundance" .

###  http://rubalkhali.science/kb#measuresTaxon
:measuresTaxon rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf sio:SIO_000132 ;  # has participant
                   rdfs:domain :TaxonAbundance ;
                   rdfs:range :Taxon ;
                   rdfs:label "measures taxon" .

###  http://rubalkhali.science/kb#forwardPrimer
:forwardPrimer rdf:type owl:DatatypeProperty ;
               rdfs:domain :AmpliconRegion ;
               rdfs:range xsd:string ;
               rdfs:label "forward primer sequence" .

###  http://rubalkhali.science/kb#reversePrimer
:reversePrimer rdf:type owl:DatatypeProperty ;
               rdfs:domain :AmpliconRegion ;
               rdfs:range xsd:string ;
               rdfs:label "reverse primer sequence" .

###  http://rubalkhali.science/kb#targetRegion
:targetRegion rdf:type owl:DatatypeProperty ;
              rdfs:domain :AmpliconRegion ;
              rdfs:range xsd:string ;
              rdfs:label "target region name" .

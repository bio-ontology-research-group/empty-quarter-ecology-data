    <!-- https://rubalkhali.science/kb/RAK_2000014 -->


    <owl:ObjectProperty rdf:about="https://rubalkhali.science/kb/RAK_2000014">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000132"/>
        <terms1:description>A relation between an extraction process and a kit used.</terms1:description>
        <rdfs:label>uses DNA extraction kit</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rubalkhali.science/kb/RAK_2000016 -->


    <owl:ObjectProperty rdf:about="https://rubalkhali.science/kb/RAK_2000016">
        <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000132"/>
        <terms1:description>A relation between a process and a primer used in that process.</terms1:description>
        <rdfs:label>uses primer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rubalkhali.science/kb/RAK_2000018 -->


    <owl:ObjectProperty rdf:about="https://rubalkhali.science/kb/RAK_2000018">
        <rdfs:subPropertyOf rdf:resource="https://rubalkhali.science/kb/RAK_2000016"/>
        <terms1:description>A relation between a process and a forward primer used.</terms1:description>
        <rdfs:label>uses forward primer</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://rubalkhali.science/kb/RAK_2000019 -->



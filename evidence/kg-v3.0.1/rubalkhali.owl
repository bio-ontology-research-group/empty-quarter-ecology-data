    <rdfs:subClassOf rdf:resource="https://rubalkhali.science/kb/RAK_0000030"/>
    <rdfs:label>Fe concentration measurement value</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">An analyte concentration measurement value reporting the concentration of iron (Fe) in a sample.</obo:IAO_0000115>
    <skos:definition xml:lang="en">An analyte concentration measurement value reporting the concentration of iron (Fe) in a sample.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rubalkhali.science/kb/RAK_0000209">

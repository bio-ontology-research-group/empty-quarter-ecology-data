  <rdf:Description rdf:about="https://rubalkhali.science/kb/RAK_0000321">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://rubalkhali.science/kb/RAK_0000319"/>
    <rdfs:label>inapplicable control metadata disposition</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A control metadata disposition stating that a control metadata item does not apply to the control concerned.</obo:IAO_0000115>
    <skos:definition xml:lang="en">A control metadata disposition stating that a control metadata item does not apply to the control concerned.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rubalkhali.science/kb/RAK_2000072">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:subPropertyOf rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
    <rdfs:domain rdf:resource="http://semanticscience.org/resource/SIO_000300"/>
    <dcterms:description>The number of reverse (R2) sequences in a paired-end FASTQ dataset.</dcterms:description>
    <rdfs:label>has reverse sequence count</rdfs:label>
    <obo:IAO_0000115 xml:lang="en">A data property relating a value-bearing entity to the number of reverse (R2) sequences in a paired-end FASTQ dataset.</obo:IAO_0000115>
    <skos:definition xml:lang="en">A data property relating a value-bearing entity to the number of reverse (R2) sequences in a paired-end FASTQ dataset.</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://rubalkhali.science/kb/RAK_0000501">

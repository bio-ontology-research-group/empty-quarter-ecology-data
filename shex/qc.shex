PREFIX rak: <https://rubalkhali.science/kb/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX uo: <http://purl.obolibrary.org/obo/UO_>
PREFIX owl: <http://www.w3.org/2002/07/owl#>

# Validation for Sequencing QC (MultiQC) Data
# Class IRIs are in the RAK_0000200-0000224 range (moved from 70-94 to avoid
# collision with bioinformatic-workflow / abundance classes).

# 1. Sequencing QC Process
<#SequencingQCProcessShape> IRI EXTRA rdf:type {
    rdf:type [rak:RAK_0000200] ;                      # Sequencing QC Process
    rdfs:label xsd:string ;
    sio:SIO_000230 IRI ;                              # has input (Dataset)
    sio:SIO_000229 @<#QCValueShape> + ;               # has output (Values)
}

# 2. Measurement Value Shape (Generic for QC)
<#QCValueShape> IRI EXTRA rdf:type {
    rdf:type [
        rak:RAK_0000214 rak:RAK_0000215               # Seq Count value (Fwd/Rev)
        rak:RAK_0000217 rak:RAK_0000218               # GC Content value (Fwd/Rev)
        rak:RAK_0000220 rak:RAK_0000221               # Dup Rate value (Fwd/Rev)
        rak:RAK_0000223 rak:RAK_0000224               # Read Length value (Fwd/Rev)
    ] ;
    rdfs:label xsd:string ;
    sio:SIO_000221 IRI ;                              # has unit
    sio:SIO_000215 @<#QCQualityShape> ;               # is measurement value of
    (   rak:RAK_2000071 xsd:integer                   # has fwd seq count
      | rak:RAK_2000072 xsd:integer                   # has rev seq count
      | rak:RAK_2000074 xsd:double                    # has fwd GC content
      | rak:RAK_2000075 xsd:double                    # has rev GC content
      | rak:RAK_2000077 xsd:double                    # has fwd dup rate
      | rak:RAK_2000078 xsd:double                    # has rev dup rate
      | rak:RAK_2000080 xsd:double                    # has fwd read length
      | rak:RAK_2000081 xsd:double                    # has rev read length
    )
}

# 3. Quality Shape
<#QCQualityShape> IRI EXTRA rdf:type {
    rdf:type [
        rak:RAK_0000202 rak:RAK_0000203               # Seq Count Quality (Fwd/Rev)
        rak:RAK_0000205 rak:RAK_0000206               # GC Content Quality (Fwd/Rev)
        rak:RAK_0000208 rak:RAK_0000209               # Dup Rate Quality (Fwd/Rev)
        rak:RAK_0000211 rak:RAK_0000212               # Read Length Quality (Fwd/Rev)
    ] ;
    rdfs:label xsd:string ;
    sio:SIO_000216 @<#QCValueShape> ;                 # hasMeasurementValue -> Value (inverse of 215)
    sio:SIO_000218 IRI ;                              # is quality of (Dataset)
    sio:SIO_000011 IRI ;                              # is attribute of (Dataset, generic)
}

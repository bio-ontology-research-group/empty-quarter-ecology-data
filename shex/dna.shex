PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX rak: <https://rubalkhali.science/kb/>
PREFIX sio: <http://semanticscience.org/resource/>
PREFIX uo: <http://purl.obolibrary.org/obo/UO_>
PREFIX pato: <http://purl.obolibrary.org/obo/PATO_>

# DNA-extract validation. Updated 2026-05-07 to match the canonical
# SIO measurement reification pattern (split quality + value):
#
#   DNA extract  --has-attribute--> Concentration quality (RAK_0000043)
#   Quality      --has-measurement-value--> Concentration value (RAK_0000044)
#   Value        --is-output-of--> Measurement process
#   Value        --has-unit--> ng/uL
#   Value        --has-DNA-concentration--> xsd:double
#
# Prior to that, DNA used a single PATO:0000033 individual playing both
# roles (collapsed pattern); see docs/MEASUREMENT_PATTERN.md for the
# rationale and tests/measurement_pattern/ for the validation harness.

<#DNAExtractShape> {
    rdf:type [rak:RAK_0000040] ;
    rdf:type IRI * ;
    rdfs:label xsd:string ;
    sio:SIO_000008 @<#DNAConcentrationQualityShape> ? ; # hasAttribute -> Quality
}

<#ExtractionProcessShape> EXTRA sio:SIO_000229 {
    rdf:type [rak:RAK_0000309] ;
    rdf:type IRI * ;
    sio:SIO_000230 IRI ;                # hasInput -> Soil Sample
    sio:SIO_000229 @<#DNAExtractShape> ; # hasOutput
    sio:SIO_000339 IRI ? ;              # isSpecifiedBy -> Protocol
    rak:RAK_2000014 IRI ? ;             # usesDNAExtractionKit
}

<#MeasurementProcessShape> {
    rdf:type [rak:RAK_0000041] ;
    rdf:type IRI * ;
    sio:SIO_000291 @<#DNAExtractShape> ;             # hasTarget
    sio:SIO_000229 @<#DNAConcentrationValueShape> ;  # hasOutput -> Value
    sio:SIO_000132 IRI ? ;                           # hasParticipant -> Nanodrop
}

<#DNAConcentrationQualityShape> {
    rdf:type [rak:RAK_0000043] ;                     # DNA concentration quality
    rdf:type IRI * ;
    rdfs:label xsd:string ? ;
    sio:SIO_000216 @<#DNAConcentrationValueShape> ;  # hasMeasurementValue -> Value
    sio:SIO_000011 @<#DNAExtractShape> ;             # isAttributeOf -> Extract
}

<#DNAConcentrationValueShape> {
    rdf:type [rak:RAK_0000044] ;                     # DNA concentration measurement value
    rdf:type IRI * ;
    rdfs:label xsd:string ? ;
    sio:SIO_000215 @<#DNAConcentrationQualityShape> ; # isMeasurementValueOf -> Quality
    sio:SIO_000232 @<#MeasurementProcessShape> ;     # isOutputOf -> Process
    sio:SIO_000221 [uo:0000275] ;                    # hasUnit -> ng/uL

    rak:RAK_2000015 xsd:double ;                     # hasDNAConcentration
}
